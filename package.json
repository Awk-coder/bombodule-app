{
  "name": "hadir",
  "private": true,
  "version": "1.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "TZ=Asia/Kuala_Lumpur vitest run",
    "test:watch": "TZ=Asia/Kuala_Lumpur vitest",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "npm run build && cap sync ios && cap open ios",
    "install:phone": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "pdfjs-dist": "^6.4.299",
    "preact": "^10.29.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
