<?xml version="1.0" encoding="utf-8"?>
<!-- Prompt card background for course palette 1 (src/ui/palette.ts): diagonal gradient plus a soft glow top-right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315" android:startColor="#5D2A85" android:centerColor="#3A0763" android:endColor="#1D0432" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:type="radial" android:centerX="0.95" android:centerY="0" android:gradientRadius="180dp" android:startColor="#40D9A8FF" android:endColor="#00D9A8FF" />
        </shape>
    </item>
</layer-list>
