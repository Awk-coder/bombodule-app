<?xml version="1.0" encoding="utf-8"?>
<!-- Prompt card background for course palette 0 (src/ui/palette.ts): diagonal gradient plus a soft glow top-right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315" android:startColor="#6C3914" android:centerColor="#421A00" android:endColor="#210D00" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:type="radial" android:centerX="0.95" android:centerY="0" android:gradientRadius="180dp" android:startColor="#40FFA65C" android:endColor="#00FFA65C" />
        </shape>
    </item>
</layer-list>
