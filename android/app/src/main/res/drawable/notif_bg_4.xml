<?xml version="1.0" encoding="utf-8"?>
<!-- Prompt card background for course palette 4 (src/ui/palette.ts): diagonal gradient plus a soft glow top-right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315" android:startColor="#1D596A" android:centerColor="#083343" android:endColor="#041A22" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:type="radial" android:centerX="0.95" android:centerY="0" android:gradientRadius="180dp" android:startColor="#4067E0F5" android:endColor="#0067E0F5" />
        </shape>
    </item>
</layer-list>
